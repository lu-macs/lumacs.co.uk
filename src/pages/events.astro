---
import Layout from '@/components/Layout.astro';
---

<Layout
  title="Events"
  description="Events for the Lancaster University Magic, Aerial & Circus Society (LUMACS)"
>
  <h1 class="text-3xl font-bold text-center">Events</h1>
  <div id="iframe-height" class="w-full" style="height: 700px">
    <iframe
      title="LUMACS events"
      scrolling="no"
      class="gallery-thumbnail"
      width="100%"
      src="https://campus.hellorubric.com/search?type=events&societyid=15351&iframe=true&showall=true&borderRadius=rounded&bodyFontFamily=Roboto&headingFontFamily=Roboto"
      frameborder="0"
      style="position: relative; height: 100%; border: none; width: 100% !important; overflow-y: hidden;"
      allowfullscreen></iframe>
  </div>
</Layout>

<script is:inline>
  window.addEventListener('message', (event) => {
    if (event.data?.type !== 'resize-iframe') return;

    const iframeSource = event.data.iframe_src;
    let iframeElement = document.querySelector(`iframe[src="${iframeSource}"]`);

    if (!iframeElement && typeof iframeSource === 'string') {
      const alternateSource = iframeSource.replace(
        'campus.hellorubric.com',
        'clubs.getqpay.com',
      );
      iframeElement = document.querySelector(
        `iframe[src="${alternateSource}"]`,
      );
    }

    const parentElement = iframeElement?.parentElement;
    if (parentElement) {
      parentElement.style.height = `${event.data.height}px`;
    }
  });
</script>
