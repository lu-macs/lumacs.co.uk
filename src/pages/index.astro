---
import Layout from '@/components/Layout.astro';
import Logo from '@/components/Logo.astro';
import { buttonVariants } from '@/components/ui/button';
import { Card, Separator } from '@/components/ui/cool-card';
import { Image } from 'astro:assets';
import { ArrowRight, Instagram, Star } from 'lucide-react';

const displays: {
  title: string;
  img: string;
}[] = [
  {
    title: 'Juggling Balls',
    img: '/display/cards/juggling.png',
  },
  // {
  //   title: 'Magic',
  //   img: '/display/cards/juggling.png',
  // },
  {
    title: 'Aerial Hoop',
    img: '/display/cards/hoop.png',
  },
  {
    title: 'LED',
    img: '/display/cards/led.png',
  },
  {
    title: 'Fire',
    img: '/display/cards/fire.png',
  },
  {
    title: 'Aerial Silks',
    img: '/display/cards/silks.png',
  },
];

const memberships: {
  name: string;
  price: number;
  mostPopular: boolean;
  benefits: string[];
  description: string;
  href: string;
}[] = [
  {
    name: 'Trial',
    price: 0,
    mostPopular: false,
    benefits: [
      'Access to all our sessions and socials for 2 weeks',
      'No fee',
      'Find out if circus is for you!',
    ],
    description: "Trouble with commitment? With our free trial membership, you can access all of our sessions, socials and events for 2 weeks starting from your first session! You can find out if LUMACS is the place for you at any point during the year, not just at the start of term!",
    href: 'https://campus.hellorubric.com/?s=15351&tab=memberships&mid=23627',
  },
  { 
    name: 'Aerial',
    price: 10,
    mostPopular: false,
    benefits: ['Access to our Sunday Aerial sessions', 'Cheapest way to do Aerial in Lancaster'],
    description: "Our aerial membership is the cheapest way to do aerial hoop and silks in Lancaster! Gain access to our Sunday aerial sessions with guided instruction from our aerial co-ordinators, as well as jamming and acrobatic time! With this membership you can also attend our socials and events, and votes in our elections.",
    href: "https://campus.hellorubric.com/?s=15351&tab=memberships&mid=23845"
  },
  {
    name: 'Weekday',
    price: 10,
    mostPopular: false,
    benefits: ['Access to our Weekday sessions'],
    description: "Join us at our Monday and Wednesday sessions! Gain access to our magic and circus equipment, regular workshops from experienced members, and try something new! With over 15 different prop types, there is something for everyone at our weekday sessions! Now introducing Magic Monday, where we will have dedicated magic workshops alongside regular session activities every Monday! With this membership you can also attend our socials and events, and votes in our elections.",
    href: "https://campus.hellorubric.com/?s=15351&tab=memberships&mid=23846"
  },
  {
    name: 'Full',
    price: 15,
    mostPopular: true,
    benefits: [
      'Access to our Sunday Aerial sessions',
      'Access to our Weekday sessions',
    ],
    description: "Want the best of both worlds? Join us at our weekday sessions for magic and circus workshops and jamming, and at our Sunday aerial session for guided aerial silks, hoop, and acrobatics! With this membership you can also attend our socials and events, and votes in our elections.",
    href: "https://campus.hellorubric.com/?s=15351&tab=memberships&mid=23844"
  },
  {
    name: 'Upgrade',
    price: 5,
    mostPopular: false,
    benefits: ['Upgrade your existing aerial or weekday membership to a full membership'],
    description: "Do you have one membership and want to upgrade to a full one? With this saver deal, you can upgrade without having to pay full price for a second membership!",
    href: "https://campus.hellorubric.com/?s=15351&tab=memberships&mid=23847"
  }
];

const generalBenefits: string[] = ['Access to our socials and events', 'Vote in our elections', 'Have fun!'];

const sessions: {
  day: string;
  time?: string;
  location: string;
  activities: string[];
}[] = [
  {
    day: 'Monday & Wednesday',
    location: 'Usually LICA, check the discord for more information',
    time: '6pm - 8pm',
    activities: ['Juggling', 'Diablo', 'Acro Staff', 'and more!', 'Aerial Hoop & Silks are available on Wednesdays by request'],
  },
  {
    day: 'Sunday',
    location: 'Brandrigg Room, Cartmel College',
    time: '4pm - 8pm',
    activities: [
      'Aerial Hoop',
      'Aerial Silks',
      'Come in time for warmup',
      'Bring/come in sports clothing and something that covers at least the back and the knees',
    ],
  },
  // {
  //   day: 'Friday',
  //   time: '5pm - 6pm',
  //   location: 'Check the discord for the location',
  //   activities: ['Bring your own equipment', 'Run on demand'],
  // },
  {
    day: 'Socials and Events',
    location: 'Check Instagram and Discord for the details',
    activities: ['Fun socials every ~2 weeks', 'Showcases hopefully termly'],
  }
];
---

<script is:inline>
  // replace all display images with plates if ?charley is present
  document.addEventListener('DOMContentLoaded', function () {
    if (window.location.search.includes('charley')) {
      document.querySelectorAll('img[src^="/display/"]').forEach(img => {
        img.src = '/display/plates2.webp';
      });
      // replace all the titles with charley
      document.querySelectorAll('.font-bold.text-2xl.text-center').forEach(title => {
        title.innerHTML = 'Charley';
      });
    } else if (window.location.search.includes('sluj')) {
      document.getElementById('slujlogo').classList.remove('hidden');
      document.getElementById('logo').classList.add('hidden');

      document.getElementById('society-name').innerHTML = 'Society of Lancaster University Jugglers';
    }
  });
</script>

<Layout
  title="Home"
  description="Lancaster University Magic, Aerial & Circus Society (LUMACS) is a fun and friendly society, welcoming people of all abilities. No experience is required to join! We host regular practice sessions and we offer the opportunity to take part in paid performances both on and off campus."
>
  <p class="text-4xl sm:text-6xl font-bold text-center" id="society-name">
    Lancaster University
    <br />
    <span class="text-primary">Magic</span>,
    <span class="text-primary">Aerial</span> &amp;
    <span class="text-primary">Circus</span> Society
  </p>

  <Logo className="right-click-branding" />
  <Image
    src="/timeline/slujlogo.png"
    alt="lumacs members displaying juggling balls"
    id="slujlogo"
    class="size-64 rounded mx-auto my-4 right-click-branding hidden"
    width={512}
    height={512}
  />

  <p
    class="text-center max-w-5xl mx-2 text-xl sm:text-3xl text-muted-foreground"
  >
    Try juggling, aerial, fire and more, <span class="font-bold text-foreground">no experience required</span>. Not sure? Get our <span class="font-bold text-foreground">2 week</span> trial membership for <span class="font-bold text-primary">free</span>! 
    We are fun and friendly society welcoming <span class="font-bold text-foreground">people of all abilities</span>. We host circus sessions Monday and Wednesday
    with aerial on Sunday; with socials running biweekly.
  </p>

  <div class="flex gap-6 flex-col items-center my-6 sm:my-8">
    <div class="flex gap-4">
      <a
        class={buttonVariants({
          size: 'lg',
          class: 'text-lg sm:text-xl font-extrabold',
        })}
        href="https://campus.hellorubric.com/?s=15351&tab=memberships"
      >
        Join Us
        <ArrowRight className="inline-block size-4 sm:size-5 ml-2" />
      </a>
      <a
        class={buttonVariants({
          variant: 'outline',
          size: 'lg',
          class: 'text-lg sm:text-xl font-extrabold',
        })}
        href="#when-we-meet"
      >
        Explore Activities
      </a>
    </div>
    <div class="flex gap-4">
      <a
        class={buttonVariants({
          variant: 'outline',
          size: 'lg',
          class: 'text-lg sm:text-xl font-extrabold',
        })}
        href="https://www.instagram.com/lu_macs/"
      >
        <Instagram className="inline-block size-4 sm:size-5 mr-2" />
        Follow Us
      </a>
      <a
        class={buttonVariants({
          variant: 'outline',
          size: 'lg',
          class: 'text-lg sm:text-xl font-extrabold',
        })}
        href="https://discord.gg/jfSUde83Pk"
      >
        Join the Discord
      </a>
    </div>

  <div class="flex gap-4">
    <a
      class={buttonVariants({
        variant: 'outline',
        size: 'lg',
        class: 'text-lg sm:text-xl font-extrabold',
      })}
      href="/merch/"
    >
      Check out our Merch!
    </a>
  </div>

  </div>

  <h2 class="font-bold text-3xl sm:text-5xl">What We Do</h2>
  <p
    class="text-center max-w-5xl mx-2 text-xl sm:text-3xl text-muted-foreground"
  >
    From juggling to aerial arts, fire performance to magic tricks - discover
    the amazing world of circus arts
  </p>

  <div class="grid gap-4 grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 m-4">
    {
      displays.map(({ img, title }) => (
        <Image
          src={img}
          alt={`lumacs members displaying ${title}`}
          class=""
          width={1200}
          height={1680}
          loading="eager"
        />
      ))
    }
  </div>

  <h2 class="font-bold text-3xl sm:text-5xl" id="when-we-meet">When We Meet</h2>
  <p
    class="text-center max-w-5xl mx-2 text-xl sm:text-3xl text-muted-foreground"
  >
    Regular sessions are held throughout the week
  </p>
  <div class="flex flex-col sm:flex-row gap-4 m-2 mt-3 flex-wrap justify-center">
    {
      sessions.map(({ day, time, activities, location }) => (
        <Card client:load>
          <div class="flex flex-col items-center p-4 w-full md:w-72 h-full">
            <span class="font-bold text-xl">{day}</span>
            {time && <span class="text-primary">{time}</span>}
            <span class="text-sm text-center text-muted-foreground">
              {location}
            </span>
            <Separator client:load className="my-2" />
              <ul class="flex flex-col gap-2 w-full">
                {activities.map((activity) => (
                  <li class="list-disc list-inside">{activity}</li>
                ))}
              </ul>
              {
                day === 'Socials and Events' && (
                  <div class="flex-grow" />
                  <a href="https://campus.hellorubric.com/?s=15351&tab=events" class={buttonVariants({ variant: 'default', class: 'w-full text-lg font-bold mt-2' })}>Explore Events</a>
                )
              }
          </div>
        </Card>
      ))
    }
  </div>

  <!-- <div class="grid gap-4 grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 m-4">
    {
      displays.map(({ img, title }) => (
        <Image
          // src={img.split('.')[0] + '.webp'}
          src="/display/placeholder.png"
          alt={`lumacs members displaying ${title}`}
          class=""
          width={1200}
          height={1680}
          loading="eager"
        />
      ))
    }
  </div> -->

  <h2 class="font-bold text-3xl sm:text-5xl">Our Memberships</h2>
  <p
    class="text-center max-w-5xl mx-2 text-xl sm:text-3xl text-muted-foreground"
  >
    We offer a variety of memberships to suit your interests
  </p>
  <div class="flex flex-col sm:flex-row gap-4 m-2 mt-3 flex-wrap justify-center">
    {
      memberships.map(({ name, price, mostPopular, benefits, href }) => (
        <Card client:load>
          <div
            class="flex flex-col items-center p-4 md:w-72 w-full md:h-96 h-80"
          >
            {mostPopular && (
              <div class="absolute -top-3 bg-primary px-1 rounded-sm flex items-center justify-center gap-1">
                <Star className="inline-block size-4" />
                Most Popular
              </div>
            )}
            <span class="font-bold text-2xl text-center">{name} Membership</span>
            <span class="text-muted-foreground font-bold text-4xl">
              <span class="text-primary">£{price}</span><!-- -->{price !== 0 && '/year'}
            </span>
            <Separator client:load className="my-2" />
            <ul class='flex flex-col gap-2 w-full list-none p-0'>
              {[...benefits, ...(price !== 0 ? generalBenefits : [])].map((benefit) => (
                <li class='before:content-["✓"] before:inline-block before:mr-2 before:text-primary before:font-extrabold'>
                  {benefit}
                </li>
              ))}
            </ul>
            <div class="flex-grow" />
            <a 
            href={href}
            class={buttonVariants({ variant: mostPopular ? 'default' : 'outline', class: 'w-full text-lg font-bold' })}
            >Join {price !== 0 ? 'Now' : 'For Free'}</a>
          </div>
        </Card>
      ))
    }
  </div>
</Layout>
